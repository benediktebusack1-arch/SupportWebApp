@page "/"

<PageTitle>IBAS Support</PageTitle>

<div class="home-container">

    <div class="hero">
        <div class="hero-content">
            <span class="welcome-text">IBAS SUPPORTSYSTEM</span>

            <h1>Velkommen til IBAS Support</h1>

            <p>
                Her kan supporthenvendelser registreres og administreres
                på ét samlet sted.
            </p>

            <div class="hero-buttons">
                <a href="/create-support" class="primary-button">
                    Opret supporthenvendelse
                </a>

                <a href="/support-list" class="secondary-button">
                    Se supporthenvendelser
                </a>
            </div>
        </div>
    </div>

    <div class="info-section">

        <div class="info-card">
            <div class="info-icon">+</div>
            <h3>Ny henvendelse</h3>
            <p>
                Opret en ny supporthenvendelse med kontaktoplysninger,
                beskrivelse og kategori.
            </p>
        </div>

        <div class="info-card">
            <div class="info-icon">☰</div>
            <h3>Supporthenvendelser</h3>
            <p>
                Få et samlet overblik over de registrerede
                supporthenvendelser.
            </p>
        </div>

        <div class="info-card">
            <div class="info-icon">✓</div>
            <h3>Samlet system</h3>
            <p>
                Alle supporthenvendelser gemmes centralt og kan
                tilgås fra systemet.
            </p>
        </div>

    </div>

</div>