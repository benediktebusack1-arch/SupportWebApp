@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services

@inject CosmosDbService CosmosDbService

<h1>Supporthenvendelser</h1>

@if (messages is null)
{
    <p>Henter supporthenvendelser...</p>
}
else if (messages.Count == 0)
{
    <p>Der er ingen supporthenvendelser.</p>
}
else
{
    <select class="category-dropdown" @onchange="CategoryChanged">
        <option value="">Alle kategorier</option>

        @foreach (var category in categories)
        {
            <option value="@category">@category</option>
        }
    </select>
        
    <table class="table">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Email</th>
                <th>Telefon</th>
                <th>Beskrivelse</th>
                <th>Kategori</th>
                <th>Dato</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var message in messages)
            {
                <tr>
                    <td>@message.Name</td>
                    <td>@message.Email</td>
                    <td>@message.Phone</td>
                    <td>@message.Description</td>
                    <td>@message.Category</td>
                    <td>@message.Date.ToLocalTime().ToString("dd-MM-yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? messages;
    private List<string> categories = new();
    private List<SupportMessage> supportMessages = new();


    protected override async Task OnInitializedAsync()
    {
        // Hent alle henvendelser
        messages = await CosmosDbService.GetSupportMessagesAsync();

        // Find de forskellige kategorier
        categories = await CosmosDbService.GetCategoriesAsync();

        supportMessages = await CosmosDbService.GetSupportMessagesAsync();
    }

    private async Task CategoryChanged(ChangeEventArgs e)
    {
        var category = e.Value?.ToString();

        if (string.IsNullOrEmpty(category))
        {
            messages = await CosmosDbService.GetSupportMessagesAsync();
        }
        else
        {
            messages = await CosmosDbService
                .GetSupportMsgByCategoryAsync(category);
        }
    }

}